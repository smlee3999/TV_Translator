<?xml version="1.0" encoding="utf-8"?>
<!-- TV overscan 안전 영역: 좌우 48dp, 상하 27dp -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="27dp"
    android:paddingEnd="48dp"
    android:paddingBottom="27dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/direction_button"
            style="@style/TvButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="260dp"
            android:nextFocusDown="@id/input_text" />

        <Button
            android:id="@+id/keyboard_button"
            style="@style/TvButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="0dp"
            android:nextFocusDown="@id/input_text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    style="@style/PanelLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/input_label" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="@string/keyboard_help"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.example.tvtranslator.HangulEditText
                android:id="@+id/input_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/panel_background"
                android:gravity="top|start"
                android:hint="@string/input_hint"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:nextFocusRight="@id/output_scroll"
                android:nextFocusUp="@id/direction_button"
                android:nextFocusDown="@id/translate_button"
                android:padding="20dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="26sp">

                <!-- 앱을 열면 바로 입력할 수 있도록 입력창에서 시작 (키보드는 stateHidden 이라 자동으로 뜨지 않음) -->
                <requestFocus />
            </com.example.tvtranslator.HangulEditText>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/output_label"
                style="@style/PanelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- 긴 결과는 포커스 후 D-pad 위/아래로 스크롤 -->
            <ScrollView
                android:id="@+id/output_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/panel_background"
                android:focusable="true"
                android:nextFocusLeft="@id/input_text"
                android:nextFocusDown="@id/translate_button"
                android:padding="20dp">

                <TextView
                    android:id="@+id/output_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textIsSelectable="false"
                    android:textSize="28sp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/translate_button"
            style="@style/TvButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="160dp"
            android:nextFocusUp="@id/input_text"
            android:text="@string/translate" />

        <Button
            android:id="@+id/clear_button"
            style="@style/TvButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:nextFocusUp="@id/input_text"
            android:text="@string/clear" />

        <Button
            android:id="@+id/use_result_button"
            style="@style/TvButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:nextFocusUp="@id/output_scroll"
            android:text="@string/use_result" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="3"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
